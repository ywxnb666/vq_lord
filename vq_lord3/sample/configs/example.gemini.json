{
  "provider": {
    "type": "gemini_native",
    "model": "${GEMINI_MODEL:-gemini-2.5-pro}",
    "base_url": "${GEMINI_API_BASE}",
    "api_key": "${GEMINI_API_KEY}",
    "http_timeout": 120,
    "max_retries": 2
  },
  "sampling": {
    "teacher_lang": "en",
    "max_workers": 4,
    "per_sample_attempts": 1,
    "save_every": 1,
    "seed": 20240306
  },
  "datasets": [
    {
      "name": "iconqa",
      "source_type": "local_parquet",
      "path": "/root/autodl-tmp/datasets/IconQA/data",
      "split": "val",
      "count": 8,
      "output_path": "outputs/iconqa_teacher_gemini_val_n8.json",
      "image_detail": "low",
      "image_max_side": 896
    }
  ]
}
